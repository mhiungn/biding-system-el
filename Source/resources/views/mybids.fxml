<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="540" prefWidth="960" styleClass="root-pane" stylesheets="@/css/mybids.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.Controller">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="root-scroll" vbarPolicy="AS_NEEDED" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

    <VBox prefWidth="960" styleClass="main-container">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <Region minHeight="40" minWidth="40" prefHeight="40" prefWidth="40" styleClass="logo" />
                <Label styleClass="app-title" text="Bidify" />
            </HBox>

            <HBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                <Button fx:id="btnBrowseAuctions" onAction="#switchToDashboard" styleClass="nav-button" text="Browse Auctions" />
                <Button fx:id="btnMyBids" styleClass="nav-button" text="My Bids" />
                <Button fx:id="btnSellItem" styleClass="nav-button" text="Sell Item" />
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button fx:id="btnSearch" styleClass="icon-button">
                    <graphic>
                        <Region styleClass="search-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnNotifications" styleClass="icon-button-badge">
                    <graphic>
                        <Region styleClass="notification-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnUserProfile" styleClass="icon-button">
                    <graphic>
                        <Region styleClass="user-icon" />
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- PAGE TITLE -->
        <VBox styleClass="page-title-section">
            <Label styleClass="page-title" text="My Bids" />
        </VBox>

        <!-- ACTIVE BIDS SECTION -->
        <VBox styleClass="active-bids-section">
            <!-- Section Header with Filters -->
            <HBox alignment="CENTER_LEFT" styleClass="section-header">
                <Label styleClass="section-heading" text="ACTIVE BIDS (3)" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnFilterAll" styleClass="filter-active" text="ALL" />
                    <Button fx:id="btnFilterWinning" styleClass="filter-btn" text="WINNING" />
                    <Button fx:id="btnFilterOutbid" styleClass="filter-btn" text="OUTBID" />
                </HBox>
            </HBox>

            <!-- Active Bids List -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="465" styleClass="active-bids-scroll" vbarPolicy="AS_NEEDED">
                <VBox fx:id="activeBidsList" spacing="15" styleClass="active-bids-list">

                    <!-- Bid Item 1 -->
                    <HBox styleClass="bid-item">
                        <Region styleClass="bid-item-image" />
                        <VBox spacing="5" styleClass="bid-item-info" HBox.hgrow="ALWAYS">
                            <Label styleClass="bid-item-title" text="Laptop Computer" />
                            <HBox spacing="15">
                                <Label styleClass="bid-item-your-bid" text="Your Bid: $850" />
                                <Label styleClass="bid-item-current" text="Current: $850" />
                            </HBox>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="8" styleClass="bid-item-right">
                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                <Region styleClass="time-icon-small" />
                                <Label styleClass="bid-item-time" text="1h 45m" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                <Region styleClass="status-icon-winning" />
                                <Label styleClass="status-winning" text="WINNING" />
                            </HBox>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="bid-item-action">
                            <Button styleClass="increase-bid-button" text="INCREASE BID" />
                        </VBox>
                    </HBox>

                    <!-- Bid Item 2 -->
                    <HBox styleClass="bid-item">
                        <Region styleClass="bid-item-image" />
                        <VBox spacing="5" styleClass="bid-item-info" HBox.hgrow="ALWAYS">
                            <Label styleClass="bid-item-title" text="Designer Watch" />
                            <HBox spacing="15">
                                <Label styleClass="bid-item-your-bid" text="Your Bid: $1150" />
                                <Label styleClass="bid-item-current" text="Current: $1200" />
                            </HBox>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="8" styleClass="bid-item-right">
                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                <Region styleClass="time-icon-small" />
                                <Label styleClass="bid-item-time" text="5h 30m" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                <Region styleClass="status-icon-outbid" />
                                <Label styleClass="status-outbid" text="OUTBID" />
                            </HBox>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="bid-item-action">
                            <Button styleClass="increase-bid-button" text="INCREASE BID" />
                        </VBox>
                    </HBox>

                    <!-- Bid Item 3 -->
                    <HBox styleClass="bid-item">
                        <Region styleClass="bid-item-image" />
                        <VBox spacing="5" styleClass="bid-item-info" HBox.hgrow="ALWAYS">
                            <Label styleClass="bid-item-title" text="Gaming Console" />
                            <HBox spacing="15">
                                <Label styleClass="bid-item-your-bid" text="Your Bid: $420" />
                                <Label styleClass="bid-item-current" text="Current: $420" />
                            </HBox>
                        </VBox>
                        <VBox alignment="CENTER_RIGHT" spacing="8" styleClass="bid-item-right">
                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                <Region styleClass="time-icon-small" />
                                <Label styleClass="bid-item-time" text="3h 10m" />
                            </HBox>
                            <HBox alignment="CENTER_RIGHT" spacing="5">
                                <Region styleClass="status-icon-winning" />
                                <Label styleClass="status-winning" text="WINNING" />
                            </HBox>
                        </VBox>
                        <VBox alignment="CENTER" styleClass="bid-item-action">
                            <Button styleClass="increase-bid-button" text="INCREASE BID" />
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>

        <!-- COMPLETED BIDS SECTION -->
        <VBox styleClass="completed-bids-section">
            <!-- Section Header -->
            <HBox styleClass="section-header">
                <Label styleClass="section-heading" text="COMPLETED BIDS (3)" />
            </HBox>

            <!-- Table Container -->
            <VBox styleClass="completed-table-container">
                <!-- Table Header -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-header">
                    <Region maxWidth="42" minWidth="42" prefWidth="42" />
                    <Label maxWidth="Infinity" styleClass="table-header-label" text="ITEM" HBox.hgrow="ALWAYS" />
                    <Label minWidth="100" prefWidth="100" styleClass="table-header-label" text="YOUR BID" />
                    <Label minWidth="110" prefWidth="110" styleClass="table-header-label" text="FINAL PRICE" />
                    <Label alignment="CENTER" minWidth="90" prefWidth="90" styleClass="table-header-label" text="STATUS" />
                    <Label minWidth="110" prefWidth="110" styleClass="table-header-label" text="DATE" />
                </HBox>

                <!-- Table Rows ScrollPane -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="225" styleClass="completed-table-scroll" vbarPolicy="AS_NEEDED">
                    <VBox fx:id="completedBidsList" spacing="0" styleClass="completed-table-rows">

                        <!-- Row 1 -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-row">
                            <Region maxWidth="42" minWidth="42" prefWidth="42" styleClass="table-item-image" />
                            <Label maxWidth="Infinity" styleClass="table-item-name" text="Vintage Camera" HBox.hgrow="ALWAYS" />
                            <Label minWidth="100" prefWidth="100" styleClass="table-value" text="380.000VND" />
                            <Label minWidth="110" prefWidth="110" styleClass="table-value" text="380.000VND" />
                            <Label alignment="CENTER" minWidth="90" prefWidth="90" styleClass="status-badge, status-won" text="WON" />
                            <Label minWidth="110" prefWidth="110" styleClass="table-value" text="Apr 14, 2026" />
                        </HBox>

                        <!-- Row 2 -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-row">
                            <Region maxWidth="42" minWidth="42" prefWidth="42" styleClass="table-item-image" />
                            <Label maxWidth="Infinity" styleClass="table-item-name" text="Art Print Set" HBox.hgrow="ALWAYS" />
                            <Label minWidth="100" prefWidth="100" styleClass="table-value" text="200.000VND" />
                            <Label minWidth="110" prefWidth="110" styleClass="table-value" text="220.000VND" />
                            <Label alignment="CENTER" minWidth="90" prefWidth="90" styleClass="status-badge, status-lost" text="LOST" />
                            <Label minWidth="110" prefWidth="110" styleClass="table-value" text="Apr 12, 2026" />
                        </HBox>

                        <!-- Row 3 -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-row">
                            <Region maxWidth="42" minWidth="42" prefWidth="42" styleClass="table-item-image" />
                            <Label maxWidth="Infinity" styleClass="table-item-name" text="Collectible Coins" HBox.hgrow="ALWAYS" />
                            <Label minWidth="100" prefWidth="100" styleClass="table-value" text="310.000VND" />
                            <Label minWidth="110" prefWidth="110" styleClass="table-value" text="350.000VND" />
                            <Label alignment="CENTER" minWidth="90" prefWidth="90" styleClass="status-badge, status-lost" text="LOST" />
                            <Label minWidth="110" prefWidth="110" styleClass="table-value" text="Apr 10, 2026" />
                        </HBox>

                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>

    </VBox>

    </ScrollPane>

</AnchorPane>
