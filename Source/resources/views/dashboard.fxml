<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER"
            styleClass="root-scroll" stylesheets="@/css/dashboard.css">

    <VBox styleClass="main-container" prefWidth="960" prefHeight="540">

        <!-- HEADER -->
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <Region styleClass="logo" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40"/>
                <Label text="Auction System" styleClass="app-title"/>
            </HBox>

            <HBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                <Button text="Browse Auctions" styleClass="nav-button" fx:id="btnBrowseAuctions"/>
                <Button text="My Bids" styleClass="nav-button" fx:id="btnMyBids"/>
                <Button text="Sell Item" styleClass="nav-button" fx:id="btnSellItem"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button styleClass="icon-button" fx:id="btnSearch">
                    <graphic>
                        <Region styleClass="search-icon"/>
                    </graphic>
                </Button>
                <Button styleClass="icon-button-badge" fx:id="btnNotifications">
                    <graphic>
                        <Region styleClass="notification-icon"/>
                    </graphic>
                </Button>
                <Button styleClass="icon-button" fx:id="btnUserProfile">
                    <graphic>
                        <Region styleClass="user-icon"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- FILTERS SECTION -->
        <HBox styleClass="filters-section" spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="FILTERS" styleClass="section-label"/>
                <HBox spacing="15">
                    <ComboBox fx:id="categoryFilter" promptText="Category: All" styleClass="filter-combo" prefWidth="300"/>
                    <ComboBox fx:id="sortFilter" promptText="Sort: Ending Soon" styleClass="filter-combo" prefWidth="300"/>
                    <ComboBox fx:id="priceRangeFilter" promptText="Price Range: Any" styleClass="filter-combo" prefWidth="300"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- STATUS SECTION -->
        <HBox styleClass="stats-section" spacing="20">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="ACTIVE AUCTIONS" styleClass="stat-label"/>
                <Label text="1,234" styleClass="stat-value" fx:id="lblActiveAuctions"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="ENDING TODAY" styleClass="stat-label"/>
                <Label text="89" styleClass="stat-value" fx:id="lblEndingToday"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="TOTAL BIDS" styleClass="stat-label"/>
                <Label text="45,678" styleClass="stat-value" fx:id="lblTotalBids"/>
            </VBox>
        </HBox>

        <!-- AUCTION CARDS GRID: EXAMPLE PROTOTYPE -->
        <GridPane fx:id="auctionCardsGrid" styleClass="cards-grid" hgap="20" vgap="20">
            <!-- Row 1 -->
            <VBox styleClass="auction-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Vintage Camera" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="350.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="2h 15m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="12 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="auction-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Designer Watch" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="1.200.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="5h 30m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="28 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="auction-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Laptop Computer" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="850.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="1h 45m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="45 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="auction-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Art Print Set" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="180.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="8h 20m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="7 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Row 2 -->
            <VBox styleClass="auction-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Gaming Console" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="420.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="3h 10m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="33 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="auction-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Antique Vase" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="650.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="6h 55m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="19 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="auction-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Collectible Coins" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="290.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="4h 40m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="15 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <VBox styleClass="auction-card" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <Region styleClass="card-image"/>
                <VBox styleClass="card-content" spacing="5">
                    <Label text="Designer Bag" styleClass="card-title"/>
                    <Label text="Current Bid" styleClass="card-subtitle"/>
                    <Label text="980.000VND" styleClass="card-price"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="time-icon"/>
                            <Label text="7h 25m" styleClass="card-meta"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-icon"/>
                            <Label text="41 bids" styleClass="card-meta"/>
                        </HBox>
                    </HBox>
                    <Button text="PLACE BID" styleClass="bid-button" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </GridPane>

        <!-- PAGINATION -->
        <HBox styleClass="pagination-section" alignment="CENTER" spacing="10">
            <Button text="&lt;" styleClass="pagination-button" fx:id="btnPrevPage"/>
            <Button text="1" styleClass="pagination-button" fx:id="btnPage1"/>
            <Button text="2" styleClass="pagination-button" fx:id="btnPage2"/>
            <Button text="3" styleClass="pagination-button" fx:id="btnPage3"/>
            <Button text="&gt;" styleClass="pagination-button" fx:id="btnNextPage"/>
        </HBox>

    </VBox>

</ScrollPane>
