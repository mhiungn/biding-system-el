<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" fitToHeight="false" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="root-scroll" stylesheets="@/css/bidding_detail.css">

    <VBox styleClass="main-container" prefWidth="960" prefHeight="540">

        <!-- HEADER -->
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="20">
            <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                <Region styleClass="logo" minWidth="40" minHeight="40" prefWidth="40" prefHeight="40"/>
                <Label text="AuctionApp" styleClass="app-title"/>
            </HBox>

            <HBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
                <Button text="Browse Auctions" styleClass="nav-button" fx:id="btnBrowseAuctions"/>
                <Button text="My Bids" styleClass="nav-button" fx:id="btnMyBids"/>
                <Button text="Sell Item" styleClass="nav-button" fx:id="btnSellItem"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="15">
                <Button styleClass="icon-button" fx:id="btnSearch">
                    <graphic>
                        <Region styleClass="search-icon"/>
                    </graphic>
                </Button>
                <Button styleClass="icon-button-badge" fx:id="btnNotifications">
                    <graphic>
                        <Region styleClass="notification-icon"/>
                    </graphic>
                </Button>
                <Button styleClass="icon-button" fx:id="btnUserProfile">
                    <graphic>
                        <Region styleClass="user-icon"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- BACK BUTTON -->
        <HBox styleClass="back-section">
            <Button styleClass="back-button" fx:id="btnBackToListings">
                <graphic>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Region styleClass="back-arrow"/>
                        <Label text="Back to Listings" styleClass="back-text"/>
                    </HBox>
                </graphic>
            </Button>
        </HBox>

        <!-- NOI DUNG CHINH -->
        <HBox styleClass="content-area" spacing="20">

            <!-- LEFT COLUMN: Image Gallery + Description -->
            <VBox styleClass="left-column" spacing="20" HBox.hgrow="NEVER">

                <!-- MAIN IMAGE -->
                <Region styleClass="main-image" fx:id="mainImage"/>

                <!-- THUMBNAIL GALLERY -->
                <HBox styleClass="thumbnail-gallery" spacing="15">
                    <Region styleClass="thumbnail" fx:id="thumbnail1">
                    </Region>
                    <Region styleClass="thumbnail" fx:id="thumbnail2">
                    </Region>
                    <Region styleClass="thumbnail" fx:id="thumbnail3">
                    </Region>
                    <Region styleClass="thumbnail" fx:id="thumbnail4">
<!--                        <Label text="4" styleClass="thumbnail-number"/>-->
                    </Region>
                </HBox>

                <!-- DESCRIPTION -->
                <VBox styleClass="description-box">
                    <Label text="DESCRIPTION" styleClass="section-title"/>
                    <ScrollPane styleClass="description-scroll" fitToWidth="true" hbarPolicy="NEVER" >
                        <Label text="Lorem ipsum dolor sit amet, consectetur adipiscing elit.&#10;&#10;Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.&#10;Ut enim ad minim veniam, quis nostrud exercitation."
                               styleClass="description-text" wrapText="true" fx:id="lblDescription"/>
                    </ScrollPane>
                </VBox>

                <!-- SPECIFICATIONS -->
                <VBox styleClass="specifications-box">
                    <Label text="SPECIFICATIONS" styleClass="section-title"/>
                    <GridPane styleClass="specs-grid" hgap="20" vgap="12">
                        <Label text="Condition:" styleClass="spec-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label text="Used - Good" styleClass="spec-value" fx:id="lblCondition" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Category:" styleClass="spec-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label text="Electronics" styleClass="spec-value" fx:id="lblCategory" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Location:" styleClass="spec-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label text="New York, USA" styleClass="spec-value" fx:id="lblLocation" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Item ID:" styleClass="spec-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label text="AUC-2-2026" styleClass="spec-value" fx:id="lblItemId" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </VBox>

            </VBox>

            <!-- RIGHT COLUMN: Title, Timer, Bidding, Seller, History -->
            <VBox styleClass="right-column" spacing="20" HBox.hgrow="NEVER">

                <!-- ITEM TITLE -->
                <Label text="Laptop Computer" styleClass="item-title" fx:id="lblItemTitle"/>

                <!-- TIME REMAINING BOX -->
                <VBox styleClass="timer-box">
                    <Label text="TIME REMAINING" styleClass="timer-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="timer-display">
                        <Region styleClass="clock-icon"/>
                        <Label text="01:45:32" styleClass="timer-value" fx:id="lblTimerValue"/>
                    </HBox>

                    <!-- TIME BREAKDOWN -->
                    <HBox spacing="15" styleClass="time-breakdown">
                        <VBox styleClass="time-unit">
                            <Label text="01" styleClass="time-number" fx:id="lblHours"/>
                            <Label text="HOURS" styleClass="time-unit-label"/>
                        </VBox>
                        <VBox styleClass="time-unit">
                            <Label text="45" styleClass="time-number" fx:id="lblMinutes"/>
                            <Label text="MINS" styleClass="time-unit-label"/>
                        </VBox>
                        <VBox styleClass="time-unit">
                            <Label text="32" styleClass="time-number" fx:id="lblSeconds"/>
                            <Label text="SECS" styleClass="time-unit-label"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- CURRENT BID BOX -->
                <VBox styleClass="current-bid-box">
                    <Label text="CURRENT BID" styleClass="bid-label"/>
                    <Label text="850.000VND" styleClass="bid-amount" fx:id="lblCurrentBid"/>
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="bid-meta">
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="bid-count-icon"/>
                            <Label text="45 bids" styleClass="bid-meta-text" fx:id="lblBidCount"/>
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Region styleClass="watcher-icon"/>
                            <Label text="32 watchers" styleClass="bid-meta-text" fx:id="lblWatcherCount"/>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- PLACE YOUR BID BOX -->
                <VBox styleClass="place-bid-box">
                    <Label text="PLACE YOUR BID" styleClass="place-bid-label"/>
                    <Label text="Minimum bid: 851.000VND" styleClass="min-bid-notice" fx:id="lblMinBid"/>
                    <TextField promptText="Enter your bid amount" styleClass="bid-input" fx:id="txtBidAmount"/>
                    <Button text="PLACE BID" styleClass="place-bid-button" maxWidth="Infinity" fx:id="btnPlaceBid"/>
                    <Button text="ADD TO WATCHLIST" styleClass="watchlist-button" maxWidth="Infinity" fx:id="btnAddWatchlist"/>
                </VBox>

                <!-- SELLER INFORMATION BOX -->
                <VBox styleClass="seller-box">
                    <Label text="SELLER INFORMATION" styleClass="seller-label"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="seller-info">
                        <Region styleClass="seller-avatar"/>
                        <Label text="seller_****92" styleClass="seller-name" fx:id="lblSellerName"/>
                    </HBox>
                    <Button text="CONTACT SELLER" styleClass="contact-seller-button" maxWidth="Infinity" fx:id="btnContactSeller"/>
                </VBox>

                <!-- BID HISTORY BOX: EXAMPLE PROTOTYPE -->
                <VBox styleClass="bid-history-box" VBox.vgrow="ALWAYS">
                    <Label text="BID HISTORY" styleClass="bid-history-label"/>
                    <ScrollPane styleClass="bid-history-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                        <VBox styleClass="bid-history-list" fx:id="bidHistoryList">

                            <HBox styleClass="bid-history-item">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="user_****23" styleClass="bidder-name"/>
                                    <Label text="2 mins ago" styleClass="bid-time"/>
                                </VBox>
                                <Label text="850.000VND" styleClass="bid-price"/>
                            </HBox>

                            <HBox styleClass="bid-history-item">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="user_****67" styleClass="bidder-name"/>
                                    <Label text="15 mins ago" styleClass="bid-time"/>
                                </VBox>
                                <Label text="820.000VND" styleClass="bid-price"/>
                            </HBox>

                            <HBox styleClass="bid-history-item">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="user_****45" styleClass="bidder-name"/>
                                    <Label text="28 mins ago" styleClass="bid-time"/>
                                </VBox>
                                <Label text="800.000VND" styleClass="bid-price"/>
                            </HBox>

                            <HBox styleClass="bid-history-item">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="user_****89" styleClass="bidder-name"/>
                                    <Label text="45 mins ago" styleClass="bid-time"/>
                                </VBox>
                                <Label text="780.000VND" styleClass="bid-price"/>
                            </HBox>

                            <HBox styleClass="bid-history-item">
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="user_****12" styleClass="bidder-name"/>
                                    <Label text="1 hour ago" styleClass="bid-time"/>
                                </VBox>
                                <Label text="750.000VND" styleClass="bid-price"/>
                            </HBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

            </VBox>

        </HBox>

    </VBox>

</ScrollPane>
