<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.scene.image.Image?>
<VBox maxHeight="576.0" maxWidth="977.0" minHeight="576.0" minWidth="977.0" prefHeight="576.0" prefWidth="977.0" styleClass="root" stylesheets="@/client/views/bidding/mybids.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.features.bidding.MyBidsController">

    <!-- ═══════════════════════════════════════════════════════════
         CUSTOM TITLE BAR (same as login)
         ═══════════════════════════════════════════════════════════ -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" styleClass="title-bar">

        <!-- Logo -->
        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">

        </ImageView>

        <!-- App title -->
        <Label styleClass="window-title" text=" ">
            <HBox.margin><Insets left="8.0" /></HBox.margin>
        </Label>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- Window controls -->
        <Button onAction="#handleMinimize" styleClass="title-bar-button" text="─" />
        <Label styleClass="disable-button" text="□" />
        <Button onAction="#handleClose" text="✕">
            <styleClass>
                <String fx:value="title-bar-button" />
                <String fx:value="close-btn" />
            </styleClass></Button>
    </HBox>


    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="root-scroll" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

    <VBox prefWidth="960" styleClass="main-container">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
            <HBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                <Region minHeight="40" minWidth="40" prefHeight="40" prefWidth="40" styleClass="logo" />
                <Label styleClass="app-title" text="Bidify" />
            </HBox>

            <HBox alignment="CENTER" spacing="8.0" HBox.hgrow="ALWAYS">
                <Button fx:id="btnBrowseAuctions" onAction="#switchToDashboard" styleClass="nav-button" text="Browse Auctions" />
                <Button fx:id="btnMyBids" styleClass="nav-button" text="My Bids" />
                <Button fx:id="btnSellItem" onAction="#switchToSellItem" styleClass="nav-button" text="Sell Item" />
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="8.0">
                <Button fx:id="btnSearch" styleClass="icon-button">
                    <graphic>
                        <Region styleClass="search-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnNotifications" styleClass="icon-button-badge">
                    <graphic>
                        <Region styleClass="notification-icon" />
                    </graphic>
                </Button>
                <Button fx:id="btnUserProfile" onAction="#openUserProfile" styleClass="icon-button">
                    <graphic>
                        <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                            <image>
                                <Image url="@/client/images/user.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </HBox>

        <!-- PAGE TITLE -->
        <VBox styleClass="page-title-section">
            <Label styleClass="page-title" text="My Bids" />
        </VBox>

        <!-- ACTIVE BIDS SECTION -->
        <VBox styleClass="active-bids-section">
            <!-- Section Header with Filters -->
            <HBox alignment="CENTER_LEFT" styleClass="section-header">
                <Label fx:id="lblActiveBidsHeading" styleClass="section-heading" text="ACTIVE BIDS (0)" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnFilterAll" styleClass="filter-active" text="ALL" />
                    <Button fx:id="btnFilterWinning" styleClass="filter-btn" text="WINNING" />
                    <Button fx:id="btnFilterOutbid" styleClass="filter-btn" text="OUTBID" />
                </HBox>
            </HBox>

            <!-- Active Bids List -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="465" styleClass="active-bids-scroll" vbarPolicy="AS_NEEDED">
                <VBox fx:id="activeBidsList" spacing="15" styleClass="active-bids-list">
                    <!-- Populated dynamically by MyBidsController -->
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- COMPLETED BIDS SECTION -->
        <VBox styleClass="completed-bids-section">
            <!-- Section Header -->
            <HBox styleClass="section-header">
                <Label fx:id="lblCompletedHeading" styleClass="section-heading" text="COMPLETED BIDS (0)" />
            </HBox>

            <!-- Table Container -->
            <VBox styleClass="completed-table-container">
                <!-- Table Header -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="table-header">
                    <Region maxWidth="42" minWidth="42" prefWidth="42" />
                    <Label maxWidth="Infinity" styleClass="table-header-label" text="ITEM" HBox.hgrow="ALWAYS" />
                    <Label minWidth="100" prefWidth="100" styleClass="table-header-label" text="YOUR BID" />
                    <Label minWidth="110" prefWidth="110" styleClass="table-header-label" text="FINAL PRICE" />
                    <Label alignment="CENTER" minWidth="90" prefWidth="90" styleClass="table-header-label" text="STATUS" />
                    <Label minWidth="110" prefWidth="110" styleClass="table-header-label" text="DATE" />
                </HBox>

                <!-- Table Rows ScrollPane -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="225" styleClass="completed-table-scroll" vbarPolicy="AS_NEEDED">
                    <VBox fx:id="completedBidsList" spacing="0" styleClass="completed-table-rows">
                        <!-- Populated dynamically by MyBidsController -->
                    </VBox>
                </ScrollPane>
            </VBox>
        </VBox>

    </VBox>

    </ScrollPane>

</VBox>
