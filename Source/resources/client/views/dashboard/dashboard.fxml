<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<VBox maxHeight="576.0" maxWidth="977.0" minHeight="576.0" minWidth="977.0" prefHeight="576.0" prefWidth="977.0" styleClass="root" stylesheets="@/client/views/dashboard/dashboard.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.features.dashboard.DashboardController">

    <!-- ═══════════════════════════════════════════════════════════
         CUSTOM TITLE BAR (same as login)
         ═══════════════════════════════════════════════════════════ -->
    <HBox fx:id="titleBar" alignment="CENTER_LEFT" onMouseDragged="#onTitleBarDragged" onMousePressed="#onTitleBarPressed" styleClass="title-bar">

        <!-- Logo -->
        <ImageView fitHeight="16" fitWidth="16" preserveRatio="true">

        </ImageView>

        <!-- App title -->
        <Label styleClass="window-title" text=" ">
            <HBox.margin><Insets left="8.0" /></HBox.margin>
        </Label>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- Window controls -->
        <Button onAction="#handleMinimize" styleClass="title-bar-button" text="─" />
        <Label styleClass="disable-button" text="□" />
        <Button onAction="#handleClose" text="✕">
         <styleClass>
            <String fx:value="title-bar-button" />
            <String fx:value="close-btn" />
         </styleClass></Button>
    </HBox>

    <!-- ═══════════════════════════════════════════════════════════
         DASHBOARD CONTENT (your existing ScrollPane structure)
         ═══════════════════════════════════════════════════════════ -->
    <ScrollPane fitToHeight="false" hbarPolicy="NEVER" styleClass="root-scroll" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">

        <VBox maxWidth="960" minHeight="800" minWidth="960" prefHeight="1636.0" prefWidth="960" styleClass="main-container">

            <!-- ─────────────────────────────────────────────────────
                 HEADER with logo, nav, icons
                 ───────────────────────────────────────────────────── -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header">
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <Region minHeight="40" minWidth="40" prefHeight="40" prefWidth="40" styleClass="logo" />
                    <Label styleClass="app-title" text="Bidify" />
                </HBox>
                <!-- NAV — centre cluster -->
                <HBox alignment="CENTER" spacing="8" HBox.hgrow="ALWAYS">
                    <Button fx:id="btnBrowseAuctions" styleClass="nav-button" text="Browse Auctions" />
                    <Button fx:id="btnMyBids" onAction="#switchToMyBids" styleClass="nav-button" text="My Bids" />
                    <Button fx:id="btnSellItem" onAction="#switchToSellItem" styleClass="nav-button" text="Sell Item" />
                </HBox>
                <!-- ICON BUTTONS — right cluster -->
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Label fx:id="lblCurrentUserQuickInfo" styleClass="auth-footer-muted" text="Guest" />
                    <Button fx:id="btnSearch" styleClass="icon-button">
                        <graphic>
                            <Region styleClass="search-icon" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnNotifications" styleClass="icon-button-badge">
                        <graphic>
                            <Region styleClass="notification-icon" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnUserProfile" onAction="#openUserProfile" styleClass="icon-button">
                        <graphic>
                            <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@/client/images/user.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </HBox>

            <!-- ─────────────────────────────────────────────────────
                 FILTERS SECTION
                 ───────────────────────────────────────────────────── -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="filters-section">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-label" text="FILTERS" />
                    <HBox spacing="12">
                        <ComboBox fx:id="categoryFilter" prefWidth="285" styleClass="filter-combo" />
                        <ComboBox fx:id="sortFilter" prefWidth="285" styleClass="filter-combo" />
                        <ComboBox fx:id="priceRangeFilter" prefWidth="285" styleClass="filter-combo" />
                    </HBox>
                </VBox>
            </HBox>

            <!-- ─────────────────────────────────────────────────────
                 STATUS SECTION
                 ───────────────────────────────────────────────────── -->
            <HBox spacing="20" styleClass="stats-section">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="ACTIVE AUCTIONS" />
                    <Label fx:id="lblActiveAuctions" styleClass="stat-value" text="0" />
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="ENDING TODAY" />
                    <Label fx:id="lblEndingToday" styleClass="stat-value" text="0" />
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-label" text="TOTAL BIDS" />
                    <Label fx:id="lblTotalBids" styleClass="stat-value" text="0" />
                </VBox>
            </HBox>

            <!-- ─────────────────────────────────────────────────────
                 AUCTION CARDS GRID
                 ───────────────────────────────────────────────────── -->
            <GridPane fx:id="auctionCardsGrid" hgap="20" minHeight="450.0" prefHeight="450.0" prefWidth="777.0" styleClass="cards-grid" vgap="20" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
                <VBox.margin>
                    <Insets />
                </VBox.margin>
            </GridPane>

            <!-- ─────────────────────────────────────────────────────
                 PAGINATION
                 ───────────────────────────────────────────────────── -->
            <HBox alignment="CENTER" spacing="8" styleClass="pagination-section">
                <Button fx:id="btnPrevPage" styleClass="pagination-button" text="‹" />
                <Button fx:id="btnPage1" styleClass="pagination-button" text="1" />
                <Button fx:id="btnPage2" styleClass="pagination-button" text="2" />
                <Button fx:id="btnPage3" styleClass="pagination-button" text="3" />
                <Button fx:id="btnNextPage" styleClass="pagination-button" text="›" />
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
